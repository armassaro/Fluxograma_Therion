# Therion Fluxo — variáveis de ambiente (copie para .env e preencha). NUNCA versione o .env.
# Itens marcados (fase N) ainda não têm efeito nas fases 1–2.

# --- Geral
TZ=America/Sao_Paulo
BASE_URL_PUBLICA=https://fluxo.exemplo.com     # URL pública do túnel Cloudflare (sem barra no fim)
N8N_BIND=127.0.0.1                             # IP onde o editor do n8n escuta: use o IP do Tailscale da VPS
N8N_ENCRYPTION_KEY=__gere_com_openssl_rand_hex_32__   # guarde uma cópia FORA do servidor

# --- Banco (um Postgres, dois bancos: POSTGRES_DB = sistema; "n8n" = dados internos do n8n)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ej_fluxo
POSTGRES_USER=ej
POSTGRES_PASSWORD=__troque__

# --- Canais (liga/desliga)
CANAL_TELEGRAM_ATIVO=true
CANAL_EMAIL_ATIVO=false            # entrada por e-mail (fase 3)
CANAL_FORMS_ATIVO=false            # (fase 3)
CANAL_WHATSAPP_ATIVO=false         # (fase 5)
NOTIFICACAO_TELEGRAM_ATIVA=true
NOTIFICACAO_EMAIL_ATIVA=true

# --- Funcionalidades (liga/desliga)
FEATURE_DRIVE=true                 # pastas e arquivos no Google Drive
FEATURE_RODIZIO=true
FEATURE_REVERSAO=true
FEATURE_FLUXOGRAMA=true
FLUXO_MOSTRAR_REVERTIDAS=true
KROKI_URL=http://kroki:8000
FEATURE_IA_DOCUMENTOS=false        # (fase 4)
ENVIO_AUTOMATICO_CLIENTE=false     # v1: sempre false (envio manual). Ponto de extensão futuro.
EXIGIR_RESPONSAVEL_ATRIBUIDO=false # true = só o responsável atribuído (ou diretor/admin) age na etapa

# --- Regras
JANELA_REVERSAO_HORAS=48
SESSAO_TTL_MIN=30
RATE_LIMIT_POR_MIN=20
ARQUIVO_TAMANHO_MAX_MB=20          # a Bot API do Telegram só deixa baixar arquivos de até 20 MB
ARQUIVO_EXTENSOES_PERMITIDAS=pdf,png,jpg,jpeg,docx,xlsx,zip,stl,3mf,step

# --- Telegram
TELEGRAM_BOT_TOKEN=__do_BotFather__
TELEGRAM_WEBHOOK_SECRET=__gere_com_openssl_rand_hex_32__
TELEGRAM_CHAT_ADMINS=              # id do chat/grupo que recebe alertas técnicos (opcional)
# TELEGRAM_API_BASE=https://api.telegram.org   # só mude em testes

# --- E-mail de saída (notificações e código de vínculo)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false                  # true = TLS direto (porta 465)
EMAIL_REMETENTE=Therion Bot <fluxo@exemplo.com>

# --- Google (service account com acesso ao Shared Drive e à planilha de membros)
GOOGLE_SA_JSON_PATH=./segredos/google_sa.json
DRIVE_RAIZ_ID=                     # id da pasta "EJ Projetos"
# Planilha de membros (privada; compartilhada como Leitor com a service account). Ver docs/runbook.md.
SHEETS_MEMBROS_ID=
# Aba vazia = ano atual (ex.: 2026). Só as colunas A-C, F, K, M-N são lidas (nunca CPF/RG/endereço).
SHEETS_MEMBROS_ABA=
SYNC_MEMBROS_CRON="*/15 * * * *"
SYNC_MAX_DESATIVACOES=5
SYNC_MAX_DESATIVACOES_PCT=20
# Diretorias da planilha que não batem com comercial/projetos/financeiro/administrativo/presidencia:
# SYNC_MAPA_DIRETORIAS=gestao de pessoas=administrativo;marketing=comercial
SYNC_MAPA_DIRETORIAS=

# --- Cloudflare Tunnel (perfil "tunel" do docker compose)
CLOUDFLARE_TUNNEL_TOKEN=
